# Copy this file to .env. Never commit .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=episodes
SUPABASE_METADATA_TABLE=episodes
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Local directories and gate settings
DATABASE_URL=postgresql+psycopg://agi_house:agi_house@localhost:5432/agi_house_capture
EPISODE_DIR=data/episodes
MIN_EPISODE_BYTES=1024
MAX_EPISODE_BYTES=524288000
MAX_EDGE_STORAGE_BYTES=53687091200
UPLOAD_STAGING_MAX_AGE_MINUTES=60

